<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>{E6517F6A-8D48-5FDF-BECA-644A6D04845F}</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>GroupDocs.Viewer.Examples.CSharp</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- One glob. Never enumerate files here: a hand-maintained list rots and
         silently drops examples from the build. [GDX401, GDX402] -->
    <Compile Include="$(MSBuildThisFileDirectory)**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="$(MSBuildThisFileDirectory)**\LoadDocumentFromAmazonS3.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LoadDocumentFromAzureBlob.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LoadDocumentFromFtp.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\UseCustomCache.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LoadXmlWithEncoding.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\MigrateOldApi.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\RenderWithThreadSafeCache.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\AspnetCoreProgram.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\AspnetCoreLicense.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\AspnetCoreAuthorization.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\AspnetCoreUiOptions.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\HtmlImageSizeProperties.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\PdfImageSizeProperties.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\ImageSizeProperties.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LegacyArchiveToHtml.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LegacyArchiveItemsPerPage.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LegacyArchiveSingleHtml.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LegacyArchiveToPdf.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LegacyArchiveToPng.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LegacyArchiveToJpeg.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LegacyArchiveFoldersInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LegacyArchiveSpecificFolder.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\LegacyArchiveFileName.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)**\CancelRendering.cs" />
  </ItemGroup>
</Project>