<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <RootNamespace>GroupDocs.Viewer.Examples.CSharp.Framework</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GroupDocs.Viewer" Version="26.10.0" />
    <!-- Tuple deconstruction is not in the net462 BCL. Must be >= what the product package itself requires, or NuGet reports a downgrade (NU1605). -->
    <PackageReference Include="System.ValueTuple" Version="4.6.1" />
  </ItemGroup>
  <Import Project="..\GroupDocs.Viewer.Examples.CSharp\GroupDocs.Viewer.Examples.CSharp.projitems" Label="Shared" />
  <ItemGroup>
    <!-- Sample data, with each example's directory structure preserved. -->
    <Content Include="..\GroupDocs.Viewer.Examples.CSharp\**\*.*"
             Exclude="..\GroupDocs.Viewer.Examples.CSharp\**\*.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
